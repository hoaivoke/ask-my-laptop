# Copy this file to .env and fill in your keys. .env is never committed.

# Claude Code login token for the server: run `claude setup-token` and paste the result here.
CLAUDE_CODE_OAUTH_TOKEN=

# Your GitHub Pages address, e.g. https://yourname.github.io  (comma-separate several; * = anyone)
ALLOWED_ORIGINS=https://hoaivoke.github.io,http://localhost:8000

# Optional: visitors type this code once per browser tab before asking (blank = open access)
ACCESS_CODE=

# How long an access-code session lasts (hours)
SESSION_HOURS=24

# How the AI refers to you (don't use your real name if you want privacy)
OWNER_NAME=the site owner
# What visitors see when Claude itself refuses a request
REFUSAL_REPLY=tsk tsk tsk nice try

# Spending guards
PER_IP_PER_MINUTE=6
PER_IP_PER_DAY=60
GLOBAL_PER_DAY=300
# How many questions the laptop answers at once, and the max seconds per answer
MAX_CONCURRENT=2
RUN_TIMEOUT_SECONDS=600

# Save visitors' questions/answers to server/logs/requests.jsonl
LOG_QUESTIONS=true
PORT=8787
